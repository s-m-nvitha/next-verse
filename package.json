{
  "name": "nextverse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 200",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "firebase:setup": "node scripts/setup-firebase.js",
    "setup:env": "node scripts/setup-env.js",
    "firebase:emulators": "firebase emulators:start",
    "firebase:emulators:detach": "firebase emulators:start --detach",
    "firebase:emulators:stop": "firebase emulators:stop",
    "firebase:deploy": "firebase deploy",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,storage:rules",
    "firebase:deploy:functions": "firebase deploy --only functions",
    "seed:data": "node scripts/seed-data.js",
    "seed:interests": "node -e \"import('./src/services/seed-data.ts').then(m => m.seedInterests())\"",
    "seed:courses": "node -e \"import('./src/services/seed-data.ts').then(m => m.seedCourses())\"",
    "seed:exams": "node -e \"import('./src/services/seed-data.ts').then(m => m.seedExams())\"",
    "seed:colleges": "node -e \"import('./src/services/seed-data.ts').then(m => m.seedColleges())\"",
    "seed:timeline": "node -e \"import('./src/services/seed-data.ts').then(m => m.seedTimeline())\"",
    "seed:scholarships": "node -e \"import('./src/services/seed-data.ts').then(m => m.seedScholarships())\"",
    "seed:jobs": "node -e \"import('./src/services/seed-data.ts').then(m => m.seedJobs())\"",
    "seed:materials": "node -e \"import('./src/services/seed-data.ts').then(m => m.seedStudyMaterials())\"",
    "seed:all": "node -e \"import('./src/services/seed-data.ts').then(m => m.seedAllData())\""
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@tanstack/react-query": "^5.8.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "firebase": "^10.14.1",
    "framer-motion": "^10.16.4",
    "i18next": "^23.5.1",
    "idb": "^7.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.288.0",
    "ogl": "^1.0.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.47.0",
    "react-i18next": "^13.5.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.17.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.4",
    "zustand": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/leaflet": "^1.9.6",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.15",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jsdom": "^22.1.0",
    "postcss": "^8.4.29",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^4.5.14",
    "vite-plugin-pwa": "^0.16.7",
    "vitest": "^0.34.3"
  }
}
