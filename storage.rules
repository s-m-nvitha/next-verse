rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can upload and manage their own files
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Public study materials are readable by all authenticated users
    match /materials/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // Only admins can upload materials
    }
    
    // Profile pictures are readable by all but only writable by the user
    match /profile-pictures/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024 // 5MB limit
        && request.resource.contentType.matches('image/.*');
    }
    
    // Admin uploads are protected
    match /admin/{allPaths=**} {
      allow read, write: if false; // Only Firebase Admin SDK
    }
  }
}
